// Prisma Schema for ZeroBooks - Production-grade Indian Accounting + ERP SaaS
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleType {
  OWNER
  ADMIN
  ACCOUNTANT
  SALES_MANAGER
  SALES_STAFF
  INVENTORY_MANAGER
  VIEWER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  SALES_RETURN
  PURCHASE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  OTHER
}

enum GSTRegistrationType {
  REGULAR
  COMPOSITION
  UNREGISTERED
  OVERSEAS
  SEZ
}

model User {
  id            String             @id @default(uuid())
  email         String             @unique
  name          String
  passwordHash  String?
  avatarUrl     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  organizations OrganizationUser[]
  auditLogs     AuditLog[]
}

model Organization {
  id                  String             @id @default(uuid())
  name                String
  legalName           String?
  businessType        String?            // Private Limited, Proprietorship, LLP, etc.
  logoUrl             String?
  email               String
  phone               String?
  website             String?
  address             String?
  city                String?
  state               String             // e.g. Gujarat
  stateCode           String             // e.g. 24
  country             String             @default("India")
  pinCode             String?
  pan                 String?
  gstin               String?
  gstRegistrationType GSTRegistrationType @default(REGULAR)
  financialYear       String             @default("2025-2026")
  currency            String             @default("INR")
  currencySymbol      String             @default("₹")
  invoicePrefix       String             @default("INV-2026-")
  nextInvoiceNumber   Int                @default(1)
  defaultTaxRate      Decimal            @default(18.0) @db.Decimal(5, 2)
  defaultPaymentTerms String             @default("Due upon receipt")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  users               OrganizationUser[]
  branches            Branch[]
  customers           Customer[]
  vendors             Vendor[]
  products            Product[]
  categories          ProductCategory[]
  warehouses          Warehouse[]
  stockMovements      StockMovement[]
  quotes              Quote[]
  salesOrders         SalesOrder[]
  invoices            Invoice[]
  payments            Payment[]
  creditNotes         CreditNote[]
  accounts            Account[]
  journalEntries      JournalEntry[]
  gstTransactions     GSTTransaction[]
  bankAccounts        BankAccount[]
  auditLogs           AuditLog[]
}

model OrganizationUser {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           RoleType     @default(OWNER)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String
  address        String?
  city           String?
  state          String?
  pinCode        String?
  isMain         Boolean      @default(false)
  isActive       Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Customer {
  id                  String             @id @default(uuid())
  organizationId      String
  customerCode        String
  customerName        String
  companyName         String?
  contactPerson       String?
  email               String?
  phone               String?
  whatsapp            String?
  website             String?
  billingAddress      String?
  shippingAddress     String?
  city                String?
  state               String
  stateCode           String
  country             String             @default("India")
  pinCode             String?
  gstin               String?
  pan                 String?
  gstRegistrationType GSTRegistrationType @default(REGULAR)
  paymentTerms        String?
  creditLimit         Decimal            @default(0.0) @db.Decimal(14, 2)
  openingBalance      Decimal            @default(0.0) @db.Decimal(14, 2)
  notes               String?
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices            Invoice[]
  payments            Payment[]
  quotes              Quote[]
  salesOrders         SalesOrder[]
  creditNotes         CreditNote[]

  @@index([organizationId])
  @@index([customerName])
}

model Vendor {
  id                  String             @id @default(uuid())
  organizationId      String
  vendorCode          String
  vendorName          String
  companyName         String?
  contactPerson       String?
  email               String?
  phone               String?
  whatsapp            String?
  address             String?
  city                String?
  state               String
  stateCode           String
  country             String             @default("India")
  pinCode             String?
  gstin               String?
  pan                 String?
  gstRegistrationType GSTRegistrationType @default(REGULAR)
  paymentTerms        String?
  creditLimit         Decimal            @default(0.0) @db.Decimal(14, 2)
  openingBalance      Decimal            @default(0.0) @db.Decimal(14, 2)
  notes               String?
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model ProductCategory {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]
}

model Warehouse {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  code           String
  address        String?
  city           String?
  state          String?
  pinCode        String?
  isActive       Boolean         @default(true)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
}

model Product {
  id                 String          @id @default(uuid())
  organizationId     String
  sku                String
  barcode            String?
  name               String
  description        String?
  type               ProductType     @default(PRODUCT)
  categoryId         String?
  brand              String?
  unit               String          @default("pcs")
  hsnSac             String?
  purchasePrice      Decimal         @default(0.0) @db.Decimal(14, 2)
  sellingPrice       Decimal         @default(0.0) @db.Decimal(14, 2)
  mrp                Decimal         @default(0.0) @db.Decimal(14, 2)
  gstRate            Decimal         @default(18.0) @db.Decimal(5, 2)
  trackInventory     Boolean         @default(true)
  allowNegativeStock Boolean         @default(false)
  openingStock       Decimal         @default(0.0) @db.Decimal(12, 3)
  minimumStock       Decimal         @default(5.0) @db.Decimal(12, 3)
  warehouseId        String?
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category           ProductCategory? @relation(fields: [categoryId], references: [id])
  stockMovements     StockMovement[]
  invoiceItems       InvoiceItem[]
  quoteItems         QuoteItem[]
  salesOrderItems    SalesOrderItem[]

  @@index([organizationId])
  @@index([sku])
  @@index([name])
}

model StockMovement {
  id             String            @id @default(uuid())
  organizationId String
  productId      String
  warehouseId    String
  quantity       Decimal           @db.Decimal(12, 3) // positive for in, negative for out
  movementType   StockMovementType
  referenceType  String?           // INVOICE, PURCHASE, ADJUSTMENT, TRANSFER
  referenceId    String?
  unitCost       Decimal           @default(0.0) @db.Decimal(14, 2)
  date           DateTime          @default(now())
  createdBy      String?
  createdAt      DateTime          @default(now())

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id])

  @@index([organizationId, productId])
}

model Quote {
  id             String       @id @default(uuid())
  organizationId String
  quoteNumber    String
  customerId     String
  date           DateTime     @default(now())
  expiryDate     DateTime?
  status         QuoteStatus  @default(DRAFT)
  subtotal       Decimal      @db.Decimal(14, 2)
  discount       Decimal      @default(0.0) @db.Decimal(14, 2)
  tax            Decimal      @default(0.0) @db.Decimal(14, 2)
  total          Decimal      @db.Decimal(14, 2)
  notes          String?
  terms          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id])
  items          QuoteItem[]
  invoices       Invoice[]
}

model QuoteItem {
  id            String   @id @default(uuid())
  quoteId       String
  productId     String?
  description   String
  quantity      Decimal  @db.Decimal(12, 3)
  unit          String   @default("pcs")
  rate          Decimal  @db.Decimal(14, 2)
  discount      Decimal  @default(0.0) @db.Decimal(14, 2)
  taxRate       Decimal  @default(18.0) @db.Decimal(5, 2)
  taxableAmount Decimal  @db.Decimal(14, 2)
  total         Decimal  @db.Decimal(14, 2)

  quote         Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id])
}

model SalesOrder {
  id             String           @id @default(uuid())
  organizationId String
  orderNumber    String
  customerId     String
  date           DateTime         @default(now())
  status         SalesOrderStatus @default(DRAFT)
  subtotal       Decimal          @db.Decimal(14, 2)
  discount       Decimal          @default(0.0) @db.Decimal(14, 2)
  tax            Decimal          @default(0.0) @db.Decimal(14, 2)
  total          Decimal          @db.Decimal(14, 2)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer         @relation(fields: [customerId], references: [id])
  items          SalesOrderItem[]
  invoices       Invoice[]
}

model SalesOrderItem {
  id            String     @id @default(uuid())
  salesOrderId  String
  productId     String?
  description   String
  quantity      Decimal    @db.Decimal(12, 3)
  unit          String     @default("pcs")
  rate          Decimal    @db.Decimal(14, 2)
  discount      Decimal    @default(0.0) @db.Decimal(14, 2)
  taxRate       Decimal    @default(18.0) @db.Decimal(5, 2)
  taxableAmount Decimal    @db.Decimal(14, 2)
  total         Decimal    @db.Decimal(14, 2)

  salesOrder    SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product       Product?   @relation(fields: [productId], references: [id])
}

model Invoice {
  id              String        @id @default(uuid())
  organizationId  String
  invoiceNumber   String
  customerId      String
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime
  status          InvoiceStatus @default(DRAFT)
  billingAddress  String?
  shippingAddress String?
  gstin           String?
  placeOfSupply   String        // State Name or State Code
  subtotal        Decimal       @db.Decimal(14, 2)
  discount        Decimal       @default(0.0) @db.Decimal(14, 2)
  taxableAmount   Decimal       @db.Decimal(14, 2)
  cgst            Decimal       @default(0.0) @db.Decimal(14, 2)
  sgst            Decimal       @default(0.0) @db.Decimal(14, 2)
  igst            Decimal       @default(0.0) @db.Decimal(14, 2)
  roundOff        Decimal       @default(0.0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(14, 2)
  amountPaid      Decimal       @default(0.0) @db.Decimal(14, 2)
  amountDue       Decimal       @db.Decimal(14, 2)
  notes           String?
  terms           String?
  quoteId         String?
  salesOrderId    String?
  journalEntryId  String?
  createdBy       String?
  postedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer      @relation(fields: [customerId], references: [id])
  quote           Quote?        @relation(fields: [quoteId], references: [id])
  salesOrder      SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  items           InvoiceItem[]
  payments        Payment[]
  creditNotes     CreditNote[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([customerId])
  @@index([invoiceDate])
}

model InvoiceItem {
  id            String   @id @default(uuid())
  invoiceId     String
  productId     String?
  description   String
  hsnSac        String?
  quantity      Decimal  @db.Decimal(12, 3)
  unit          String   @default("pcs")
  rate          Decimal  @db.Decimal(14, 2)
  discount      Decimal  @default(0.0) @db.Decimal(14, 2)
  taxRate       Decimal  @default(18.0) @db.Decimal(5, 2)
  taxableAmount Decimal  @db.Decimal(14, 2)
  cgst          Decimal  @default(0.0) @db.Decimal(14, 2)
  sgst          Decimal  @default(0.0) @db.Decimal(14, 2)
  igst          Decimal  @default(0.0) @db.Decimal(14, 2)
  total         Decimal  @db.Decimal(14, 2)

  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
}

model Payment {
  id             String        @id @default(uuid())
  organizationId String
  customerId     String
  invoiceId      String?
  paymentDate    DateTime      @default(now())
  amount         Decimal       @db.Decimal(14, 2)
  paymentMethod  PaymentMethod @default(BANK_TRANSFER)
  bankAccountId  String?
  reference      String?
  notes          String?
  journalEntryId String?
  createdBy      String?
  createdAt      DateTime      @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer      @relation(fields: [customerId], references: [id])
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])

  @@index([organizationId])
  @@index([customerId])
}

model CreditNote {
  id             String       @id @default(uuid())
  organizationId String
  creditNoteNumber String
  customerId     String
  invoiceId      String
  date           DateTime     @default(now())
  reason         String
  subtotal       Decimal      @db.Decimal(14, 2)
  tax            Decimal      @db.Decimal(14, 2)
  total          Decimal      @db.Decimal(14, 2)
  journalEntryId String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id])
  invoice        Invoice      @relation(fields: [invoiceId], references: [id])
}

model Account {
  id              String             @id @default(uuid())
  organizationId  String
  code            String             // e.g. "1000", "1100", "4000"
  name            String             // e.g. "Cash", "Accounts Receivable", "Sales Revenue"
  type            AccountType
  parentId        String?
  isSystemAccount Boolean            @default(false)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent          Account?           @relation("AccountHierarchy", fields: [parentId], references: [id])
  children        Account[]          @relation("AccountHierarchy")
  journalLines    JournalEntryLine[]

  @@unique([organizationId, code])
  @@index([organizationId, type])
}

model JournalEntry {
  id             String             @id @default(uuid())
  organizationId String
  branchId       String?
  entryNumber    String             // e.g. "JE-2026-0001"
  date           DateTime           @default(now())
  referenceType  String?            // INVOICE, PAYMENT, REVERSAL, MANUAL, BILL
  referenceId    String?
  description    String
  status         JournalStatus      @default(POSTED)
  reversalOfId   String?
  createdBy      String?
  postedAt       DateTime?          @default(now())
  createdAt      DateTime           @default(now())

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines          JournalEntryLine[]

  @@unique([organizationId, entryNumber])
  @@index([organizationId, date])
}

model JournalEntryLine {
  id             String       @id @default(uuid())
  journalEntryId String
  accountId      String
  description    String?
  debit          Decimal      @default(0.0) @db.Decimal(14, 2)
  credit         Decimal      @default(0.0) @db.Decimal(14, 2)

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

model GSTTransaction {
  id             String       @id @default(uuid())
  organizationId String
  referenceType  String       // INVOICE, BILL, CREDIT_NOTE
  referenceId    String
  date           DateTime     @default(now())
  gstin          String?
  stateCode      String
  taxableAmount  Decimal      @db.Decimal(14, 2)
  cgst           Decimal      @default(0.0) @db.Decimal(14, 2)
  sgst           Decimal      @default(0.0) @db.Decimal(14, 2)
  igst           Decimal      @default(0.0) @db.Decimal(14, 2)
  totalTax       Decimal      @db.Decimal(14, 2)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
}

model BankAccount {
  id             String       @id @default(uuid())
  organizationId String
  bankName       String
  accountName    String
  accountNumber  String
  ifsc           String
  openingBalance Decimal      @default(0.0) @db.Decimal(14, 2)
  currentBalance Decimal      @default(0.0) @db.Decimal(14, 2)
  isActive       Boolean      @default(true)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         String       // e.g. "INVOICE_POSTED", "CUSTOMER_CREATED"
  entityType     String       // "Invoice", "Customer", "JournalEntry"
  entityId       String
  timestamp      DateTime     @default(now())
  metadata       String?      // JSON string of previous/new details

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, timestamp])
}
